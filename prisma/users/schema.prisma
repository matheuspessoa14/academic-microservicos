generator client {
  provider = "prisma-client"
  output   = "../../generated/users"

  // Compatibilidade com nosso projeto CJS + Rspack.
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
}